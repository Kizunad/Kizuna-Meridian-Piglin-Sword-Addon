definitions {
  id: "meridian_piglin_sword:wind_around"
  version: 1
  category: ATTACK
  minimum_realm: WANDERING_QI
  slots {
    id: "hand_meridian"
    module: MERIDIAN
    tags: "human:hand_meridian"
    minimum_count: 1
    maximum_count: 6
    require_opened: true
  }
  slots {
    id: "arm_muscle"
    module: TISSUE
    tags: "human:arm_muscle"
    minimum_count: 1
    maximum_count: 6
  }
  cost {
    qi {
      slot_id: "hand_meridian"
      phase: FREE
      matching: ANY_ATTRIBUTE_AT_LEAST_PHASE
      amount { value: 3 unit: QI }
      distribution: EVEN
    }
  }
  phases {
    warmup_millis: 350
    active_millis: 0
    recovery_millis: 650
    interruptible_by_damage: true
  }
  cooldown_millis: 3000
  follow_up {
    transitions {
      previous { id: "meridian_piglin_sword:coil" version: 1 }
      recovery_start_ratio { value: 0 unit: RATIO }
      after_recovery_millis: 500
      after_bind_release_millis: 500
      start_millis: 175
    }
  }
  effects {
    at_millis: 0
    presentation {
      id: "meridian_piglin_sword:piglin_sword_wind_around"
      duration: UNTIL_RECOVERY_END
      start_millis: 0
    }
  }
  effects {
    at_millis: 350
    weapon_strike {
      shape: SINGLE_TARGET
      distance { value: 3 unit: METER }
      angle { value: 60 unit: DEGREE }
      facing_offset { value: 0 unit: DEGREE }
      multiplier { value: 1 unit: RATIO }
      maximum_targets: 1
      cast_target_limit: 1
      knockback { value: 0 unit: RATIO }
      can_two_hand: false
      two_hand_multiplier { value: 1 unit: RATIO }
      break_shield: false
      injury_override: CUTTING
      last_strike: true
      durability_base: 1
      shield_cooldown_millis: 0
      shield_break_millis: 0
      dedup_group: "wind_around"
      main_hand_damage_type_id: "meridian_piglin_sword:wind_around_main_hand"
      off_hand_damage_type_id: "meridian_piglin_sword:wind_around_off_hand"
      damage_type_item_tag: "meridian_piglin_sword:soft_blades"
      heat_status_id: "meridian_piglin_sword:molten"
      heated_main_hand_damage_type_id: "meridian_piglin_sword:wind_around_main_hand"
      heated_off_hand_damage_type_id: "meridian_piglin_sword:wind_around_off_hand"
    }
  }
  presentation {
    icon_id: "meridian_piglin_sword:wind_around"
    display_name: "绕"
    description: "剑尖不与盾面争力，顺着缝隙绕进去。"
  }
}

